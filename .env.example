# ── LLM: Groq (free tier) ─────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Search: Tavily (free tier, 1000 searches/month) ───
# Get a key at https://app.tavily.com/  (leave blank to use DuckDuckGo only)
TAVILY_API_KEY=your_tavily_api_key_here

# ── Model tiering (all free on Groq) ──────────────────
# Groq's model catalog changes over time. If you get a 404 "model does
# not exist", list your available models:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# then update these. Small model for volume, large model for synthesis.
MANAGER_MODEL=openai/gpt-oss-20b
RESEARCHER_MODEL=openai/gpt-oss-20b
SYNTHESIZER_MODEL=openai/gpt-oss-120b
CRITIC_MODEL=openai/gpt-oss-20b

# ── Pipeline guardrails ───────────────────────────────
MAX_SUB_QUESTIONS=4
MAX_RESULTS_PER_SEARCH=5
MAX_CONTENT_CHARS=2000
MAX_CONCURRENCY=3
ENABLE_CRITIC=false
MAX_CRITIC_REVISIONS=1

# ── LLM call reliability ──────────────────────────────
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ── Persistence ───────────────────────────────────────
SQLITE_PATH=data/runs.db
